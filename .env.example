# SZGMU Schedule Bot - Environment Configuration Template
#
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control!

# ============================================
# REQUIRED VARIABLES
# ============================================

# Telegram Bot Token (required)
# Get this from @BotFather on Telegram
# Format: <bot_id>:<secret> (example: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567890)
BOT_TOKEN=your_bot_token_here

# ============================================
# OPTIONAL VARIABLES (with defaults)
# ============================================

# Database URL
# Default: sqlite+aiosqlite:///./data/szgmu_bot.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dbname
# DATABASE_URL=sqlite+aiosqlite:///./data/szgmu_bot.db

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# SZGMU API Base URL
# Default: https://frsview.szgmu.ru/api
# Change only if the university changes their API endpoint
# API_BASE_URL=https://frsview.szgmu.ru/api

# ============================================
# DEVELOPMENT & TESTING
# ============================================

# Set to true for development mode (more verbose logging)
# DEV_MODE=false

# Enable debug logging for specific modules
# DEBUG_MODULES=app.bot,app.services

# ============================================
# PERFORMANCE TUNING
# ============================================

# Database connection pool size
# DB_POOL_SIZE=5

# HTTP client timeout (seconds)
# HTTP_TIMEOUT=30

# ============================================
# NOTES
# ============================================
#
# 1. After copying to .env, fill in at minimum the BOT_TOKEN
# 2. The bot will use sensible defaults for all optional variables
# 3. Secrets are automatically redacted in logs
# 4. See docs/configuration.md for more details
#
# Quick start:
#   cp .env.example .env
#   # Edit .env and add your BOT_TOKEN
#   uv run szgmu-bot
